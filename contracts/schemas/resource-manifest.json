{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-vue-admin.local/schemas/resource-manifest.json",
  "title": "Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "table", "label", "primary_key", "fields"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "label": { "type": "string", "minLength": 1 },
    "primary_key": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
    "soft_delete": { "type": "boolean", "default": false },
    "audit": { "type": "boolean", "default": false },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": { "type": "string" },
        "get": { "type": "string" },
        "create": { "type": "string" },
        "update": { "type": "string" },
        "delete": { "type": "string" }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "label"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
          "type": {
            "enum": ["text", "textarea", "number", "select", "checkbox", "switch", "date", "datetime"]
          },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": false },
          "searchable": { "type": "boolean", "default": false },
          "sortable": { "type": "boolean", "default": true },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "relation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "foreign_key", "display_field"],
            "properties": {
              "resource": { "type": "string" },
              "foreign_key": { "type": "string" },
              "display_field": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

APP_NAME=Go Vue Admin
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Required for the Task 5 bootstrap login until the persistent user module lands.
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Platform Admin

# Resource storage mode: memory (default) or database.
# When database is selected, DB_CONNECTION selects mysql or postgres for
# both Goravel migrations and the application-owned GORM resource pool.
RESOURCE_PROVIDER=memory

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=go_vue_admin
DB_USERNAME=root
DB_PASSWORD=root
# DB_SSLMODE=disable
# DB_SCHEMA=public

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

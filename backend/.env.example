APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=postgres
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
